                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <TextBlock Text="Unidades:" Style="{StaticResource PropLabelStyle}"/>
                <ComboBox Style="{StaticResource PropComboStyle}" MinWidth="90" SelectedIndex="0">
                    <ComboBoxItem Content="Milímetros"/>
                    <ComboBoxItem Content="Centímetros"/>
                    <ComboBoxItem Content="Pulgadas"/>
                    <ComboBoxItem Content="Puntos"/>
                    <ComboBoxItem Content="Píxeles"/>
                </ComboBox>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <TextBlock Text="Duplicar distancia:" Style="{StaticResource PropLabelStyle}"/>
                <TextBox Style="{StaticResource PropTextBoxStyle}" Text="5,0" Width="46"/>
                <TextBlock Text="mm" Style="{StaticResource PropLabelStyle}"/>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <TextBlock Text="Nudge:" Style="{StaticResource PropLabelStyle}"/>
                <TextBox Style="{StaticResource PropTextBoxStyle}" Text="2,0" Width="42"/>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <TextBlock Text="Alinear:" Style="{StaticResource PropLabelStyle}"/>
                <Button Style="{StaticResource GridButtonStyle}" ToolTip="Alinear a la izquierda">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M3,2 V18 M6,5 H15 V9 H6 Z M6,11 H11 V15 H6 Z"/>
                </Button>
                <Button Style="{StaticResource GridButtonStyle}" ToolTip="Centrar horizontalmente">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M9,2 V18 M4,5 H14 V9 H4 Z M6,11 H12 V15 H6 Z"/>
                </Button>
                <Button Style="{StaticResource GridButtonStyle}" ToolTip="Alinear a la derecha">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M15,2 V18 M3,5 H12 V9 H3 Z M7,11 H12 V15 H7 Z"/>
                </Button>
                <Button Style="{StaticResource GridButtonStyle}" ToolTip="Alinear arriba">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M2,3 H18 M5,6 H9 V14 H5 Z M11,6 H15 V12 H11 Z"/>
                </Button>
                <Button Style="{StaticResource GridButtonStyle}" ToolTip="Centrar verticalmente">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M2,9 H18 M5,4 H9 V7 H5 Z M5,11 H9 V14 H5 Z M11,4 H15 V12 H11 Z"/>
                </Button>
                <Button Style="{StaticResource GridButtonStyle}" ToolTip="Alinear abajo">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Data="M2,15 H18 M5,4 H9 V14 H5 Z M11,6 H15 V14 H11 Z"/>
                </Button>
                <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                <CheckBox Content="Bordes de página" FontSize="11" Foreground="{StaticResource TextSecondary}" IsChecked="True" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>


        <!-- ========== DOCUMENT TABS BAR ========== -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Documentos" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,6,0"/>

                <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0">
                    <StackPanel x:Name="DocumentTabsPanel" Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                </ScrollViewer>

                <Button Grid.Column="2" Style="{StaticResource DocumentTabStyle}"
                        Padding="10,6" Margin="0,0,10,0" Click="NewTab_Click"
                        ToolTip="Nuevo documento (Ctrl+N)">
                    <TextBlock Text="+" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ========== COREldRAW TOOLBOX ========== -->
        <Border Grid.Row="4" Grid.Column="0"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,6" HorizontalAlignment="Center">

                    <ToggleButton x:Name="SelectToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Selección (V)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Select">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Data="M3,2 L3,20 L8,15 L11,21 L13.5,20 L10.5,14.2 L17,14 Z"/>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="ShapeToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Forma / editar nodos (F10)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Shape">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4,17 C7,6 15,6 18,3 M2,15 H5 V18 H2 Z"/>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="CropToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Recortar página (arrastra un rectángulo)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Crop">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Data="M6,2 V18 H22 M2,6 H18 V22"/>
                    </ToggleButton>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="8,5"/>

                    <Button x:Name="ZoomToolBtn" Style="{StaticResource ToolboxCmdStyle}"
                            ToolTip="Zoom (Z)" Click="ZoomTool_Click">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M16,10 A6,6 0 1 1 4,10 A6,6 0 1 1 16,10 M15,15 L20,20"/>
                    </Button>

                    <Button x:Name="PanToolBtn" Style="{StaticResource ToolboxCmdStyle}"
                            ToolTip="Mano / Desplazar (H)" Click="PanTool_Click">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,3 L12,21 M12,3 L9,6 M12,3 L15,6 M12,21 L9,18 M12,21 L15,18 M3,12 L21,12 M3,12 L6,9 M3,12 L6,15 M21,12 L18,9 M21,12 L18,15"/>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="8,5"/>

                    <ToggleButton x:Name="PencilToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Lápiz / Trazo libre (P)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Pencil">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4,16 L4,20 L8,20 L19,9 L15,5 Z M13,7 L17,11"/>
                            <Button x:Name="PencilFlyoutBtn" Style="{StaticResource ToolFlyoutButtonStyle}" Tag="Pencil"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2"
                                    ToolTip="Más herramientas" Click="ToolFlyout_Click">
                                <Path Width="6" Height="6" Fill="{StaticResource TextMuted}" Data="M0,6 L6,6 L6,0 Z"/>
                            </Button>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="PenToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Pluma vectorial / curvas (N)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Pen">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4,20 L6,14 L14,6 C15,5 17,5 18,6 C19,7 19,9 18,10 L10,18 Z M6,14 L10,18"/>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="BrushToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Pincel (B)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Brush">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M15,3 L21,9 L13,17 C10,20 5,20 4,19 C3,18 4,16 6,15 Z M15,3 L17,5"/>
                    </ToggleButton>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="8,5"/>

                    <ToggleButton x:Name="RectToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Rectángulo (R)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Rectangle">
                        <Grid>
                            <Rectangle Width="16" Height="12" RadiusX="2" RadiusY="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"/>
                            <Button x:Name="RectFlyoutBtn" Style="{StaticResource ToolFlyoutButtonStyle}" Tag="Rectangle"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2"
                                    ToolTip="Más herramientas" Click="ToolFlyout_Click">
                                <Path Width="6" Height="6" Fill="{StaticResource TextMuted}" Data="M0,6 L6,6 L6,0 Z"/>
                            </Button>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="EllipseToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Elipse (E)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Ellipse">
                        <Grid>
                            <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"/>
                            <Button x:Name="EllipseFlyoutBtn" Style="{StaticResource ToolFlyoutButtonStyle}" Tag="Ellipse"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2"
                                    ToolTip="Más herramientas" Click="ToolFlyout_Click">
                                <Path Width="6" Height="6" Fill="{StaticResource TextMuted}" Data="M0,6 L6,6 L6,0 Z"/>
                            </Button>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="PolygonToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Polígono (Y)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Polygon">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Data="M10,2 L17,6 L17,14 L10,18 L3,14 L3,6 Z"/>
                            <Button x:Name="PolygonFlyoutBtn" Style="{StaticResource ToolFlyoutButtonStyle}" Tag="Polygon"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2"
                                    ToolTip="Más herramientas" Click="ToolFlyout_Click">
                                <Path Width="6" Height="6" Fill="{StaticResource TextMuted}" Data="M0,6 L6,6 L6,0 Z"/>
                            </Button>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="StarToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Estrella" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Star">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M10,2 L12.4,7.6 L18.5,8.1 L13.8,12.1 L15.3,18 L10,14.8 L4.7,18 L6.2,12.1 L1.5,8.1 L7.6,7.6 Z"/>
                    </ToggleButton>

                    <ToggleButton x:Name="LineToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Línea (L)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Line">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,19 L19,5"/>
                    </ToggleButton>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="8,5"/>

                    <ToggleButton x:Name="TextToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Texto (T)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Text">
                        <TextBlock Text="T" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="8,5"/>

                    <ToggleButton x:Name="FillToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Relleno interactivo (G)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Fill">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M5,9 L11,3 L19,11 L13,17 Z M19,11 C21,14 19,19 16,18"/>
                    </ToggleButton>

                    <ToggleButton x:Name="EyedropperToolBtn" Style="{StaticResource ToolboxToolStyle}"
                                  ToolTip="Cuentagotas de color (I)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Eyedropper">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M14,3 L19,8 M16.5,5.5 L8,14 L4,18 L8,18 L17.5,8.5"/>
                    </ToggleButton>

                    <Button x:Name="OutlineToolBtn" Style="{StaticResource ToolboxCmdStyle}" ToolTip="Aplicar contorno a la selección" Click="OutlineTool_Click">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M4,18 L6,12 L14,4 L18,8 L10,16 Z M12,6 L16,10"/>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="8,5"/>

                    <Button x:Name="ImportImgBtn" Style="{StaticResource ToolboxCmdStyle}"
                            ToolTip="Importar imagen (Ctrl+I)" Click="ImportImage_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,5 H20 V19 H4 Z M4,16 L9,11 L13,15 L16,12 L20,16 M9,8.5 A1.5,1.5 0 1 1 9,11.5 A1.5,1.5 0 1 1 9,8.5"/>
                    </Button>

                    <Button x:Name="DeleteBtn" Style="{StaticResource ToolboxCmdStyle}"
                            ToolTip="Eliminar (Del)" Click="Delete_Click">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5,7 H19 M9,7 V4.5 H15 V7 M6.5,7 L8,20 H16 L17.5,7 M10,10 V17 M14,10 V17"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========== CENTER CANVAS AREA (WITH RULERS) ========== -->
        <Border Grid.Row="4" Grid.Column="1" Background="{StaticResource PasteboardBrush}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RulerRow" Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RulerCol" Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgTeritary}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,1"/>

                <Border x:Name="HorizontalRuler" Grid.Row="0" Grid.Column="1"
                        Background="{StaticResource HRulerBrush}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"/>

                <Border x:Name="VerticalRuler" Grid.Row="1" Grid.Column="0"
                        Background="{StaticResource VRulerBrush}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0"/>

                <ScrollViewer x:Name="CanvasScrollViewer" Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              MouseMove="CanvasScrollViewer_MouseMove"
                              PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel"
                              Focusable="True"
                              Background="Transparent">
                    <Grid x:Name="PasteboardGrid" Background="Transparent" MinWidth="4000" MinHeight="4000">
                        <Border x:Name="PaperBorder"
                                Width="794" Height="1123"
                                Background="{StaticResource PaperBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Effect="{StaticResource PaperShadow}"
                                Margin="1603,1439,0,0"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1"/>

                        <Canvas x:Name="DrawingCanvas"
                                Width="4000" Height="4000"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                MouseDown="DrawingCanvas_MouseDown"
                                MouseRightButtonUp="DrawingCanvas_MouseRightButtonUp"
                                MouseMove="DrawingCanvas_MouseMove"
                                MouseUp="DrawingCanvas_MouseUp"
                                MouseLeave="DrawingCanvas_MouseLeave"
                                Focusable="True"
                                Background="Transparent">
                            <Canvas x:Name="SelectionLayer" Panel.ZIndex="1000000" Background="{x:Null}"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== RIGHT PANELS ========== -->
        <Border Grid.Row="4" Grid.Column="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0">
            <TabControl x:Name="RightTabControl"
                        Background="Transparent" BorderThickness="0"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MinimalTabItemStyle}"/>
                </TabControl.ItemContainerStyle>

                <!-- ============ OBJETO ============ -->
                <TabItem Header="OBJETO">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="OBJETO" Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="ObjectNameText" Style="{StaticResource PanelTextBoxStyle}" TextChanged="ObjectNameText_TextChanged"/>

                            <TextBlock Text="Opacidad" Style="{StaticResource FieldLabelStyle}"/>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource PanelSliderStyle}"
                                    Minimum="0" Maximum="1" Value="1" ValueChanged="OpacitySlider_ValueChanged"/>

                            <TextBlock Text="Rotación" Style="{StaticResource FieldLabelStyle}"/>
                            <Slider x:Name="RotationSlider" Style="{StaticResource PanelSliderStyle}"
                                    Minimum="0" Maximum="360" Value="0" ValueChanged="RotationSlider_ValueChanged"/>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="POSICIÓN" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PosXText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="0" TextChanged="PosXText_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PosYText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="0" TextChanged="PosYText_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="TAMAÑO" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ancho" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SizeWText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="100" TextChanged="SizeWText_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alto" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SizeHText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="100" TextChanged="SizeHText_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="APARIENCIA" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="40" Height="30" Margin="0,0,10,0" ToolTip="Trazo (clic izq.) / Relleno (clic der.)">
                                    <Border x:Name="FillColorIndicator" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="Transparent" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3"/>
                                    <Border x:Name="StrokeColorIndicator" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="Black" BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                                </Grid>
                                <ComboBox x:Name="StrokeThicknessCombo" Grid.Column="1" Style="{StaticResource PanelComboBoxStyle}"
                                          Margin="0" SelectionChanged="StrokeThickness_SelectionChanged" SelectedIndex="1">
                                    <ComboBoxItem Content="0.5 pt"/>
                                    <ComboBoxItem Content="1 pt"/>
                                    <ComboBoxItem Content="2 pt"/>
                                    <ComboBoxItem Content="3 pt"/>
                                    <ComboBoxItem Content="5 pt"/>
                                    <ComboBoxItem Content="8 pt"/>
                                    <ComboBoxItem Content="12 pt"/>
                                </ComboBox>
                            </Grid>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="TRAZO" Style="{StaticResource PanelHeaderStyle}"/>

                            <TextBlock Text="Estilo de línea" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="LineStyleCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="LineStyle_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="———  Sólida" Tag="Solid"/>
                                <ComboBoxItem Content="– – –  Guiones" Tag="Dash"/>
                                <ComboBoxItem Content="· · ·  Puntos" Tag="Dot"/>
                                <ComboBoxItem Content="– · –  Guion-punto" Tag="DashDot"/>
                                <ComboBoxItem Content="– ·· –  Guion-punto-punto" Tag="DashDotDot"/>
                                <ComboBoxItem Content="———  Guion largo" Tag="LongDash"/>
                            </ComboBox>

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Extremos" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="LineCapCombo" Style="{StaticResource PanelComboBoxStyle}" Margin="0,0,0,8"
                                              SelectionChanged="LineCap_SelectionChanged" SelectedIndex="1">
                                        <ComboBoxItem Content="Recto" Tag="Flat"/>
                                        <ComboBoxItem Content="Redondo" Tag="Round"/>
                                        <ComboBoxItem Content="Cuadrado" Tag="Square"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Uniones" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="LineJoinCombo" Style="{StaticResource PanelComboBoxStyle}" Margin="0,0,0,8"
                                              SelectionChanged="LineJoin_SelectionChanged" SelectedIndex="1">
                                        <ComboBoxItem Content="Recta" Tag="Miter"/>
                                        <ComboBoxItem Content="Redonda" Tag="Round"/>
                                        <ComboBoxItem Content="Bisel" Tag="Bevel"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Estilos rápidos" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel x:Name="StrokePresetsPanel" Margin="10,0" Orientation="Horizontal"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ CAPAS ============ -->
                <TabItem Header="CAPAS">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Mini toolbar -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgTeritary}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <DockPanel>
                                <TextBlock Text="CAPAS" Style="{StaticResource PanelHeaderStyle}" Margin="4,0"
                                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Nueva capa" Click="AddLayer_Click">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M9,3 V15 M3,9 H15"/>
                                    </Button>
                                    <Button x:Name="DuplicateLayerBtn" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Duplicar capa" Click="DuplicateLayer_Click">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeLineJoin="Round"
                                              Data="M4,4 H11 V11 H4 Z M6,6 H13 V13 H6 Z"/>
                                    </Button>
                                    <Button x:Name="DeleteLayerBtn" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Eliminar capa" Click="DeleteLayer_Click">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M5,6 H15 M8,6 V4 H12 V6 M6.5,6 L7.5,16 H12.5 L13.5,6 M9,9 V13 M11,9 V13"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Layer list -->
                        <ListBox Grid.Row="1" x:Name="LayersList"
                                 Style="{StaticResource LayerListBoxStyle}"
                                 ItemContainerStyle="{StaticResource LayerListItemStyle}"
                                 SelectionChanged="LayersList_SelectionChanged"
                                 MouseDoubleClick="LayersList_MouseDoubleClick"
                                 Padding="0,4"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  Style="{StaticResource LayerVisibilityToggleStyle}"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>

                                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="5"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                Background="{StaticResource PaperBrush}"
                                                BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
                                            <Path Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="{StaticResource TextMuted}" StrokeThickness="1.1" StrokeLineJoin="Round"
                                                  Data="M8,2 L14,5 L8,8 L2,5 Z M2,8 L8,11 L14,8 M2,10.5 L8,13.5 L14,10.5"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12.5" Padding="2,0" BorderThickness="1"
                                                         Background="{StaticResource BgTeritary}"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource AccentBrush}"
                                                         CaretBrush="{StaticResource AccentBrush}"
                                                         Loaded="LayerNameEdit_Loaded"
                                                         KeyDown="LayerNameEdit_KeyDown"
                                                         LostKeyboardFocus="LayerNameEdit_LostKeyboardFocus">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                            <TextBlock Text="{Binding Elements.Count, StringFormat={}{0} objetos}"
                                                       FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="3"
                                                      IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                                      Style="{StaticResource LayerLockToggleStyle}"
                                                      VerticalAlignment="Center" Margin="6,0,2,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- ============ COLORES ============ -->
                <TabItem Header="COLORES">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="COLOR ACTUAL" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,2,12,6" Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="52" Height="40" Margin="0,0,12,0">
                                    <Border x:Name="FillColorIndicatorLarge" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="Transparent" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4"/>
                                    <Border x:Name="StrokeColorIndicatorLarge" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="Black" BorderBrush="White" BorderThickness="2" CornerRadius="4"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Clic izq.: aplicar al trazo" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                    <TextBlock Text="Clic der.: aplicar al relleno" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="PALETA" Style="{StaticResource PanelHeaderStyle}"/>
                            <WrapPanel x:Name="ColorPalette" ItemWidth="24" ItemHeight="24" Margin="10,0"/>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="DEGRADADOS" Style="{StaticResource PanelHeaderStyle}"/>
                            <WrapPanel x:Name="GradientPalette" ItemWidth="120" ItemHeight="36" Margin="10,0"/>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="MEZCLADOR" Style="{StaticResource PanelHeaderStyle}"/>
                            <StackPanel Margin="12,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="R:" Width="20" VerticalAlignment="Center" FontSize="12" Foreground="#E4572E"/>
                                    <Slider x:Name="MixerRSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0" Maximum="255" Value="255" ValueChanged="Mixer_Changed"/>
                                    <TextBlock x:Name="MixerRText" Text="255" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G:" Width="20" VerticalAlignment="Center" FontSize="12" Foreground="#37B24D"/>
                                    <Slider x:Name="MixerGSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0" Maximum="255" Value="0" ValueChanged="Mixer_Changed"/>
                                    <TextBlock x:Name="MixerGText" Text="0" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="B:" Width="20" VerticalAlignment="Center" FontSize="12" Foreground="#1C7ED6"/>
                                    <Slider x:Name="MixerBSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0" Maximum="255" Value="0" ValueChanged="Mixer_Changed"/>
                                    <TextBlock x:Name="MixerBText" Text="0" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Border x:Name="MixerPreview" Height="30" Margin="0,8,0,0" CornerRadius="6"
                                        BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                        Background="Red"/>
                                <Button Content="Aplicar a trazo" Margin="0,8,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ApplyMixerToStroke_Click"/>
                                <Button Content="Aplicar a relleno" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}"
                                        Click="ApplyMixerToFill_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ TEXTO ============ -->
                <TabItem Header="TEXTO">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="FUENTE" Style="{StaticResource PanelHeaderStyle}"/>
                            <ComboBox x:Name="FontFamilyCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="FontFamilyCombo_SelectionChanged"/>

                            <TextBlock Text="TAMAÑO" Style="{StaticResource PanelHeaderStyle}"/>
                            <ComboBox x:Name="FontSizeCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      IsEditable="True"
                                      SelectionChanged="FontSizeCombo_SelectionChanged"
                                      KeyDown="FontSizeCombo_KeyDown"
                                      LostKeyboardFocus="FontSizeCombo_LostKeyboardFocus"
                                      ToolTip="Elige un tamaño o escribe uno personalizado"
                                      SelectedIndex="4">
                                <ComboBoxItem Content="8 pt"/><ComboBoxItem Content="10 pt"/><ComboBoxItem Content="12 pt"/>
                                <ComboBoxItem Content="14 pt"/><ComboBoxItem Content="16 pt"/><ComboBoxItem Content="18 pt"/>
                                <ComboBoxItem Content="24 pt"/><ComboBoxItem Content="32 pt"/><ComboBoxItem Content="48 pt"/>
                                <ComboBoxItem Content="72 pt"/>
                            </ComboBox>

                            <TextBlock Text="ESTILO" Style="{StaticResource PanelHeaderStyle}"/>
                            <StackPanel Margin="12,2">
                                <CheckBox x:Name="BoldCheck" Content="Negrita" Style="{StaticResource PanelCheckBoxStyle}" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed"/>
                                <CheckBox x:Name="ItalicCheck" Content="Cursiva" Style="{StaticResource PanelCheckBoxStyle}" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed"/>
                                <CheckBox x:Name="UnderlineCheck" Content="Subrayado" Style="{StaticResource PanelCheckBoxStyle}" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed"/>
                            </StackPanel>

                            <TextBlock Text="ALINEACIÓN" Style="{StaticResource PanelHeaderStyle}"/>
                            <ComboBox x:Name="TextAlignmentCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="TextAlignmentCombo_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="Izquierda" Tag="Left"/>
                                <ComboBoxItem Content="Centro" Tag="Center"/>
                                <ComboBoxItem Content="Derecha" Tag="Right"/>
                                <ComboBoxItem Content="Justificado" Tag="Justify"/>
                            </ComboBox>

                            <TextBlock Text="ESPACIADO" Style="{StaticResource PanelHeaderStyle}"/>
                            <StackPanel Margin="12,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Interlineado:" Width="80" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="LineHeightSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0.5" Maximum="3" Value="1.2" ValueChanged="LineHeight_Changed"/>
                                    <TextBlock x:Name="LineHeightText" Text="1.2" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Esp. caracteres:" Width="100" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="CharSpacingSlider" Style="{StaticResource PanelSliderStyle}" Minimum="-50" Maximum="200" Value="0" ValueChanged="CharSpacing_Changed"/>
                                    <TextBlock x:Name="CharSpacingText" Text="0" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ========== VERTICAL COLOR STRIP ========== -->
        <Border Grid.Row="4" Grid.Column="3"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Style="{StaticResource ToolbarButtonStyle}" Width="22" Height="16"
                        ToolTip="Mostrar más colores" Click="MoreColors_Click">
                    <Path Width="9" Height="6" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0,6 L9,6 L4.5,0 Z"/>
                </Button>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Margin="0,2">
                    <StackPanel x:Name="ScreenPalette" Orientation="Vertical" HorizontalAlignment="Center"/>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ToolbarButtonStyle}" Width="22" Height="16"
                        ToolTip="Más colores" Click="MoreColors_Click">
                    <Path Width="9" Height="6" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M0,0 L9,0 L4.5,6 Z"/>
                </Button>
            </Grid>
        </Border>

        <!-- ========== STATUS BAR ========== -->
        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Listo"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Border Grid.Column="1" Width="1" Height="14" Background="{StaticResource BorderDefault}" Margin="0,0,8,0"/>

                <TextBlock x:Name="ToolStatusText" Grid.Column="2" Text="Herramienta: Selección"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

                <Grid Grid.Column="4" Width="36" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"
                      ToolTip="Trazo (clic izq.) / Relleno (clic der.)">
                    <Border x:Name="FillColorIndicatorBar" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="Transparent" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3"/>
                    <Border x:Name="StrokeColorIndicatorBar" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Black" BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                </Grid>

                <TextBlock Grid.Column="5" Text="Página 1 de 1" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock x:Name="CoordinateText" Grid.Column="6" Text="X: 0, Y: 0" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock x:Name="ZoomText" Grid.Column="7" Text="100%" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
