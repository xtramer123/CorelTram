<Window x:Class="CorelTram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:local="clr-namespace:CorelTram"
        mc:Ignorable="d po"
        Title="CorelTram" Height="950" Width="1500"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F4F4F6"
        Foreground="#1B1B1F"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- Accent -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF8C00"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9E26"/>
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E67E00"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF1E0"/>

                    <!-- Surfaces -->
                    <SolidColorBrush x:Key="PasteboardBrush" Color="#ADADB2"/>
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BgToolbar" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="BgPanel" Color="#FCFCFD"/>
                    <SolidColorBrush x:Key="BgHover" Color="#F2F2F4"/>
                    <SolidColorBrush x:Key="BgActive" Color="#E9E9EC"/>
                    <SolidColorBrush x:Key="BgTeritary" Color="#F6F6F8"/>

                    <!-- Borders -->
                    <SolidColorBrush x:Key="BorderSubtle" Color="#EFEFF1"/>
                    <SolidColorBrush x:Key="BorderDefault" Color="#E2E2E5"/>
                    <SolidColorBrush x:Key="BorderDark" Color="#CFCFD4"/>

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1F"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#6A6A72"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#A2A2AA"/>

                    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
                    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

                    <!-- Shadows (frozen so they can be shared) -->
                    <DropShadowEffect x:Key="ShadowSmall" po:Freeze="True" BlurRadius="6" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
                    <DropShadowEffect x:Key="PaperShadow" po:Freeze="True" BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
                    <DropShadowEffect x:Key="TabShadow" po:Freeze="True" BlurRadius="4" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global ToolTip -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#1B1B1F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== DOCUMENT TAB ========== -->
            <Style x:Key="DocumentTabStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                                    <Button x:Name="CloseBtn" Grid.Column="1" Content="✕" FontSize="9" FontWeight="Bold"
                                            Foreground="{StaticResource TextMuted}" Background="Transparent" BorderThickness="0"
                                            Width="16" Height="16" Margin="8,0,0,0" Padding="0" Cursor="Hand"
                                            Visibility="Collapsed">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="3" Padding="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#FF6B6B"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHover}"/>
                                    <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource PaperBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== RIGHT TAB ========== -->
            <Style x:Key="MinimalTabItemStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Padding" Value="12,11"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                        Background="{StaticResource AccentBrush}" Opacity="0" Margin="10,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== SIDEBAR TOOL BUTTON (toggle) ========== -->
            <Style x:Key="SidebarToolButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource ButtonCornerRadius}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== SIDEBAR BUTTON (command) ========== -->
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource ButtonCornerRadius}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BgActive}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== PRIMARY / GHOST BUTTONS ========== -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHover}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== COLOR SWATCH ========== -->
            <Style x:Key="ColorSwatchStyle" TargetType="Border">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ========== PANEL TEXT ========== -->
            <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Margin" Value="12,14,12,6"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="Margin" Value="12,0,12,4"/>
            </Style>

            <!-- ========== SLIDER ========== -->
            <Style x:Key="PanelSliderStyle" TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="12,0,12,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Background="{StaticResource AccentBrush}" BorderThickness="0" Height="4"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Background="{StaticResource BgActive}" BorderThickness="0" Height="4"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{StaticResource AccentBrush}" Stroke="White" StrokeThickness="2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========== COMBOBOX ========== -->
            <Style x:Key="PanelComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="12,0,12,8"/>
            </Style>

            <!-- ========== TEXTBOX ========== -->
            <Style x:Key="PanelTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Margin" Value="12,0,12,8"/>
            </Style>

            <!-- ========== CHECKBOX ========== -->
            <Style x:Key="PanelCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="12,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- ========== SEPARATOR ========== -->
            <Style x:Key="PanelSeparatorStyle" TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="Margin" Value="8,10"/>
                <Setter Property="Height" Value="1"/>
            </Style>

            <Style x:Key="MinimalThumbStyle" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1.5" Opacity="0.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PanelScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <ScrollContentPresenter/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Width="8" HorizontalAlignment="Right"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                           Background="Transparent" BorderThickness="0">
                                    <ScrollBar.Template>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb Background="{StaticResource BorderDark}" Style="{StaticResource MinimalThumbStyle}"/>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0"/>
                                                </Track.DecreaseRepeatButton>
                                            </Track>
                                        </ControlTemplate>
                                    </ScrollBar.Template>
                                </ScrollBar>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LayerListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- Menu Bar -->
            <RowDefinition Height="36"/>        <!-- Document Tabs -->
            <RowDefinition Height="*"/>         <!-- Main Content -->
            <RowDefinition Height="36"/>        <!-- Screen Palette -->
            <RowDefinition Height="26"/>        <!-- Status Bar -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>      <!-- Tool Sidebar -->
            <ColumnDefinition Width="*"/>       <!-- Canvas Area -->
            <ColumnDefinition Width="288"/>     <!-- Right Panels -->
        </Grid.ColumnDefinitions>

        <!-- ========== MENU BAR ========== -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Background="{StaticResource BgToolbar}"
              BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
              Height="28" Padding="4,0">
            <MenuItem Header="_Archivo" Foreground="{StaticResource TextPrimary}">
                <MenuItem Header="_Nuevo" Click="NewFile_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Abrir..." Click="OpenFile_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Guardar" Click="SaveFile_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Guardar _como..." Click="SaveAsFile_Click"/>
                <Separator/>
                <MenuItem Header="_Importar..." Click="ImportImage_Click" InputGestureText="Ctrl+I"/>
                <Separator/>
                <MenuItem Header="_Cerrar pestaña" Click="CloseTab_Click" InputGestureText="Ctrl+W"/>
                <MenuItem Header="Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Editar" Foreground="{StaticResource TextPrimary}">
                <MenuItem Header="_Deshacer" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Rehacer" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Cortar" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copiar" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Pegar" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="_Eliminar" Click="Delete_Click" InputGestureText="Del"/>
                <MenuItem Header="Seleccionar _todo" InputGestureText="Ctrl+A"/>
            </MenuItem>
            <MenuItem Header="_Ver" Foreground="{StaticResource TextPrimary}">
                <MenuItem Header="_Acercar" Click="ZoomIn_Click" InputGestureText="Ctrl++"/>
                <MenuItem Header="_Alejar" Click="ZoomOut_Click" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Ajustar a _ventana" Click="FitToWindow_Click" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem Header="Mostrar _reglas" IsCheckable="True" IsChecked="True" Click="ToggleRulers_Click"/>
                <MenuItem Header="Mostrar _cuadrícula" IsCheckable="True" IsChecked="True" Click="ToggleGrid_Click"/>
                <MenuItem Header="Alinear a _cuadrícula" IsCheckable="True" Click="ToggleSnapToGrid_Click"/>
            </MenuItem>
            <MenuItem Header="_Ventana" Foreground="{StaticResource TextPrimary}" x:Name="WindowMenu">
                <MenuItem Header="Nueva _ventana" Click="NewWindow_Click"/>
            </MenuItem>
            <MenuItem Header="_Ayuda" Foreground="{StaticResource TextPrimary}">
                <MenuItem Header="_Acerca de" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ========== DOCUMENT TABS BAR ========== -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="TabScrollViewer" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="6,0">
                    <StackPanel x:Name="DocumentTabsPanel" Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                </ScrollViewer>

                <Button Grid.Column="1" Style="{StaticResource DocumentTabStyle}"
                        Padding="10,6" Margin="0,0,10,0" Click="NewTab_Click"
                        ToolTip="Nuevo documento (Ctrl+N)">
                    <TextBlock Text="+" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ========== LEFT TOOL SIDEBAR ========== -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,10" HorizontalAlignment="Center">
                    <ToggleButton x:Name="SelectToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Selección (V)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Select">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M3,2 L3,20 L8,15 L11,21 L13.5,20 L10.5,14.2 L17,14 Z"/>
                    </ToggleButton>

                    <ToggleButton x:Name="RectToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Rectángulo (R)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Rectangle">
                        <Rectangle Width="16" Height="12" RadiusX="2" RadiusY="2"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"/>
                    </ToggleButton>

                    <ToggleButton x:Name="EllipseToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Elipse (E)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Ellipse">
                        <Ellipse Width="16" Height="16"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"/>
                    </ToggleButton>

                    <ToggleButton x:Name="LineToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Línea (L)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Line">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,19 L19,5"/>
                    </ToggleButton>

                    <ToggleButton x:Name="PencilToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Lápiz / Trazo libre (P)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Pencil">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,16 L4,20 L8,20 L19,9 L15,5 Z M13,7 L17,11"/>
                    </ToggleButton>

                    <ToggleButton x:Name="BrushToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Pincel (B)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Brush">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M15,3 L21,9 L13,17 C10,20 5,20 4,19 C3,18 4,16 6,15 Z M15,3 L17,5"/>
                    </ToggleButton>

                    <ToggleButton x:Name="TextToolBtn" Style="{StaticResource SidebarToolButtonStyle}"
                                  ToolTip="Texto (T)" Checked="Tool_Checked" Unchecked="Tool_Unchecked" Tag="Text">
                        <TextBlock Text="T" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Separator Style="{StaticResource PanelSeparatorStyle}" Margin="10,10"/>

                    <Button x:Name="PanToolBtn" Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Mano / Desplazar (H)" Click="PanTool_Click">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,3 L12,21 M12,3 L9,6 M12,3 L15,6 M12,21 L9,18 M12,21 L15,18 M3,12 L21,12 M3,12 L6,9 M3,12 L6,15 M21,12 L18,9 M21,12 L18,15"/>
                    </Button>

                    <Button x:Name="ZoomToolBtn" Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Zoom (Z)" Click="ZoomTool_Click">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M16,10 A6,6 0 1 1 4,10 A6,6 0 1 1 16,10 M15,15 L20,20"/>
                    </Button>

                    <Separator Style="{StaticResource PanelSeparatorStyle}" Margin="10,10"/>

                    <Button x:Name="ImportImgBtn" Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Importar imagen (Ctrl+I)" Click="ImportImage_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,5 H20 V19 H4 Z M4,16 L9,11 L13,15 L16,12 L20,16 M9,8.5 A1.5,1.5 0 1 1 9,11.5 A1.5,1.5 0 1 1 9,8.5"/>
                    </Button>

                    <Button x:Name="DeleteBtn" Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Eliminar (Del)" Click="Delete_Click">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5,7 H19 M9,7 V4.5 H15 V7 M6.5,7 L8,20 H16 L17.5,7 M10,10 V17 M14,10 V17"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========== CENTER CANVAS AREA ========== -->
        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource PasteboardBrush}" ClipToBounds="True">
            <ScrollViewer x:Name="CanvasScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          MouseMove="CanvasScrollViewer_MouseMove"
                          PreviewMouseWheel="CanvasScrollViewer_PreviewMouseWheel"
                          Focusable="True"
                          Background="Transparent">
                <Grid x:Name="PasteboardGrid" Background="Transparent">
                    <Border x:Name="PaperBorder"
                            Width="794" Height="1123"
                            Background="{StaticResource PaperBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Effect="{StaticResource PaperShadow}"
                            Margin="300,300,0,0"
                            BorderBrush="{StaticResource BorderDark}" BorderThickness="1"/>

                    <Canvas x:Name="DrawingCanvas"
                            Width="1394" Height="1723"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MouseDown="DrawingCanvas_MouseDown"
                            MouseMove="DrawingCanvas_MouseMove"
                            MouseUp="DrawingCanvas_MouseUp"
                            MouseLeave="DrawingCanvas_MouseLeave"
                            Focusable="True"
                            Background="Transparent">
                        <Canvas x:Name="SelectionLayer" Panel.ZIndex="1000000" Background="{x:Null}"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ========== RIGHT PANELS ========== -->
        <Border Grid.Row="2" Grid.Column="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0">
            <TabControl x:Name="RightTabControl"
                        Background="Transparent" BorderThickness="0"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MinimalTabItemStyle}"/>
                </TabControl.ItemContainerStyle>

                <!-- ============ OBJETO ============ -->
                <TabItem Header="OBJETO">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="OBJETO" Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="ObjectNameText" Style="{StaticResource PanelTextBoxStyle}" TextChanged="ObjectNameText_TextChanged"/>

                            <TextBlock Text="Opacidad" Style="{StaticResource FieldLabelStyle}"/>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource PanelSliderStyle}"
                                    Minimum="0" Maximum="1" Value="1" ValueChanged="OpacitySlider_ValueChanged"/>

                            <TextBlock Text="Rotación" Style="{StaticResource FieldLabelStyle}"/>
                            <Slider x:Name="RotationSlider" Style="{StaticResource PanelSliderStyle}"
                                    Minimum="0" Maximum="360" Value="0" ValueChanged="RotationSlider_ValueChanged"/>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="POSICIÓN" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PosXText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="0" TextChanged="PosXText_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PosYText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="0" TextChanged="PosYText_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="TAMAÑO" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ancho" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SizeWText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="100" TextChanged="SizeWText_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alto" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SizeHText" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,8" Text="100" TextChanged="SizeHText_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="APARIENCIA" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="40" Height="30" Margin="0,0,10,0" ToolTip="Trazo (clic izq.) / Relleno (clic der.)">
                                    <Border x:Name="FillColorIndicator" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="Transparent" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3"/>
                                    <Border x:Name="StrokeColorIndicator" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="Black" BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                                </Grid>
                                <ComboBox x:Name="StrokeThicknessCombo" Grid.Column="1" Style="{StaticResource PanelComboBoxStyle}"
                                          Margin="0" SelectionChanged="StrokeThickness_SelectionChanged" SelectedIndex="1">
                                    <ComboBoxItem Content="0.5 pt"/>
                                    <ComboBoxItem Content="1 pt"/>
                                    <ComboBoxItem Content="2 pt"/>
                                    <ComboBoxItem Content="3 pt"/>
                                    <ComboBoxItem Content="5 pt"/>
                                    <ComboBoxItem Content="8 pt"/>
                                    <ComboBoxItem Content="12 pt"/>
                                </ComboBox>
                            </Grid>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="TRAZO" Style="{StaticResource PanelHeaderStyle}"/>

                            <TextBlock Text="Estilo de línea" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="LineStyleCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="LineStyle_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="———  Sólida" Tag="Solid"/>
                                <ComboBoxItem Content="– – –  Guiones" Tag="Dash"/>
                                <ComboBoxItem Content="· · ·  Puntos" Tag="Dot"/>
                                <ComboBoxItem Content="– · –  Guion-punto" Tag="DashDot"/>
                                <ComboBoxItem Content="– ·· –  Guion-punto-punto" Tag="DashDotDot"/>
                                <ComboBoxItem Content="———  Guion largo" Tag="LongDash"/>
                            </ComboBox>

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Extremos" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="LineCapCombo" Style="{StaticResource PanelComboBoxStyle}" Margin="0,0,0,8"
                                              SelectionChanged="LineCap_SelectionChanged" SelectedIndex="1">
                                        <ComboBoxItem Content="Recto" Tag="Flat"/>
                                        <ComboBoxItem Content="Redondo" Tag="Round"/>
                                        <ComboBoxItem Content="Cuadrado" Tag="Square"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Uniones" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="LineJoinCombo" Style="{StaticResource PanelComboBoxStyle}" Margin="0,0,0,8"
                                              SelectionChanged="LineJoin_SelectionChanged" SelectedIndex="1">
                                        <ComboBoxItem Content="Recta" Tag="Miter"/>
                                        <ComboBoxItem Content="Redonda" Tag="Round"/>
                                        <ComboBoxItem Content="Bisel" Tag="Bevel"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Estilos rápidos" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel x:Name="StrokePresetsPanel" Margin="10,0" Orientation="Horizontal"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ CAPAS ============ -->
                <TabItem Header="CAPAS">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="CAPAS" Style="{StaticResource PanelHeaderStyle}"/>
                            <ListBox x:Name="LayersList" Style="{StaticResource LayerListBoxStyle}"
                                     SelectionChanged="LayersList_SelectionChanged"
                                     MinHeight="200"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8,4" Margin="4,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Style="{StaticResource PanelCheckBoxStyle}"
                                                          Margin="0,0,8,0" Padding="0" Width="18" Height="18" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="10,8" HorizontalAlignment="Right">
                                <Button Content="+ Nueva capa" Style="{StaticResource GhostButtonStyle}" Padding="12,6" FontSize="11"
                                        Click="AddLayer_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ COLORES ============ -->
                <TabItem Header="COLORES">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="COLOR ACTUAL" Style="{StaticResource PanelHeaderStyle}"/>
                            <Grid Margin="12,2,12,6" Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="52" Height="40" Margin="0,0,12,0">
                                    <Border x:Name="FillColorIndicatorLarge" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="Transparent" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4"/>
                                    <Border x:Name="StrokeColorIndicatorLarge" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="Black" BorderBrush="White" BorderThickness="2" CornerRadius="4"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Clic izq.: aplicar al trazo" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                    <TextBlock Text="Clic der.: aplicar al relleno" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="PALETA" Style="{StaticResource PanelHeaderStyle}"/>
                            <WrapPanel x:Name="ColorPalette" ItemWidth="24" ItemHeight="24" Margin="10,0"/>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="DEGRADADOS" Style="{StaticResource PanelHeaderStyle}"/>
                            <WrapPanel x:Name="GradientPalette" ItemWidth="120" ItemHeight="36" Margin="10,0"/>

                            <Separator Style="{StaticResource PanelSeparatorStyle}"/>
                            <TextBlock Text="MEZCLADOR" Style="{StaticResource PanelHeaderStyle}"/>
                            <StackPanel Margin="12,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="R:" Width="20" VerticalAlignment="Center" FontSize="12" Foreground="#E4572E"/>
                                    <Slider x:Name="MixerRSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0" Maximum="255" Value="255" ValueChanged="Mixer_Changed"/>
                                    <TextBlock x:Name="MixerRText" Text="255" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G:" Width="20" VerticalAlignment="Center" FontSize="12" Foreground="#37B24D"/>
                                    <Slider x:Name="MixerGSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0" Maximum="255" Value="0" ValueChanged="Mixer_Changed"/>
                                    <TextBlock x:Name="MixerGText" Text="0" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="B:" Width="20" VerticalAlignment="Center" FontSize="12" Foreground="#1C7ED6"/>
                                    <Slider x:Name="MixerBSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0" Maximum="255" Value="0" ValueChanged="Mixer_Changed"/>
                                    <TextBlock x:Name="MixerBText" Text="0" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Border x:Name="MixerPreview" Height="30" Margin="0,8,0,0" CornerRadius="6"
                                        BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                                        Background="Red"/>
                                <Button Content="Aplicar a trazo" Margin="0,8,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ApplyMixerToStroke_Click"/>
                                <Button Content="Aplicar a relleno" Margin="0,6,0,0" Style="{StaticResource GhostButtonStyle}"
                                        Click="ApplyMixerToFill_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ TEXTO ============ -->
                <TabItem Header="TEXTO">
                    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
                        <StackPanel Margin="0,4,0,16">
                            <TextBlock Text="FUENTE" Style="{StaticResource PanelHeaderStyle}"/>
                            <ComboBox x:Name="FontFamilyCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="FontFamilyCombo_SelectionChanged"/>

                            <TextBlock Text="TAMAÑO" Style="{StaticResource PanelHeaderStyle}"/>
                            <ComboBox x:Name="FontSizeCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="FontSizeCombo_SelectionChanged" SelectedIndex="4">
                                <ComboBoxItem Content="8 pt"/><ComboBoxItem Content="10 pt"/><ComboBoxItem Content="12 pt"/>
                                <ComboBoxItem Content="14 pt"/><ComboBoxItem Content="16 pt"/><ComboBoxItem Content="18 pt"/>
                                <ComboBoxItem Content="24 pt"/><ComboBoxItem Content="32 pt"/><ComboBoxItem Content="48 pt"/>
                                <ComboBoxItem Content="72 pt"/>
                            </ComboBox>

                            <TextBlock Text="ESTILO" Style="{StaticResource PanelHeaderStyle}"/>
                            <StackPanel Margin="12,2">
                                <CheckBox x:Name="BoldCheck" Content="Negrita" Style="{StaticResource PanelCheckBoxStyle}" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed"/>
                                <CheckBox x:Name="ItalicCheck" Content="Cursiva" Style="{StaticResource PanelCheckBoxStyle}" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed"/>
                                <CheckBox x:Name="UnderlineCheck" Content="Subrayado" Style="{StaticResource PanelCheckBoxStyle}" Checked="TextStyle_Changed" Unchecked="TextStyle_Changed"/>
                            </StackPanel>

                            <TextBlock Text="ALINEACIÓN" Style="{StaticResource PanelHeaderStyle}"/>
                            <ComboBox x:Name="TextAlignmentCombo" Style="{StaticResource PanelComboBoxStyle}"
                                      SelectionChanged="TextAlignmentCombo_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="Izquierda" Tag="Left"/>
                                <ComboBoxItem Content="Centro" Tag="Center"/>
                                <ComboBoxItem Content="Derecha" Tag="Right"/>
                                <ComboBoxItem Content="Justificado" Tag="Justify"/>
                            </ComboBox>

                            <TextBlock Text="ESPACIADO" Style="{StaticResource PanelHeaderStyle}"/>
                            <StackPanel Margin="12,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Interlineado:" Width="80" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="LineHeightSlider" Style="{StaticResource PanelSliderStyle}" Minimum="0.5" Maximum="3" Value="1.2" ValueChanged="LineHeight_Changed"/>
                                    <TextBlock x:Name="LineHeightText" Text="1.2" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Esp. caracteres:" Width="100" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <Slider x:Name="CharSpacingSlider" Style="{StaticResource PanelSliderStyle}" Minimum="-50" Maximum="200" Value="0" ValueChanged="CharSpacing_Changed"/>
                                    <TextBlock x:Name="CharSpacingText" Text="0" Width="34" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ========== SCREEN PALETTE ========== -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="36" Height="26" Margin="0,0,6,0"
                      ToolTip="Trazo (clic izq.) / Relleno (clic der.)">
                    <Border x:Name="FillColorIndicatorBar" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="Transparent" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3"/>
                    <Border x:Name="StrokeColorIndicatorBar" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Black" BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
                </Grid>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="6,0" VerticalAlignment="Center">
                    <StackPanel x:Name="ScreenPalette" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>

                <Button Grid.Column="2" Content="Más colores" Style="{StaticResource GhostButtonStyle}"
                        Padding="10,4" FontSize="11" VerticalAlignment="Center" Click="MoreColors_Click"/>
            </Grid>
        </Border>

        <!-- ========== STATUS BAR ========== -->
        <StatusBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Background="{StaticResource BgToolbar}"
                   BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                   Foreground="{StaticResource TextSecondary}" FontSize="11">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Listo" Margin="4,0"/>
            </StatusBarItem>
            <Separator Style="{StaticResource PanelSeparatorStyle}" Width="1" Height="14" Margin="4,0" Background="{StaticResource BorderDefault}"/>
            <StatusBarItem>
                <TextBlock x:Name="ToolStatusText" Text="Herramienta: Selección" Margin="4,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CoordinateText" Text="X: 0, Y: 0" Margin="4,0"/>
            </StatusBarItem>
            <Separator Style="{StaticResource PanelSeparatorStyle}" Width="1" Height="14" Margin="4,0" Background="{StaticResource BorderDefault}"/>
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,12,0">
                <TextBlock x:Name="ZoomText" Text="100%"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
