                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Deshacer (Ctrl+Z)" Click="Undo_Click">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
