                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Ajustar a ventana (Ctrl+0)" Click="FitToWindow_Click">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3,7 V3 H7 M13,3 H17 V7 M17,13 V17 H13 M7,17 H3 V13"/>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                    <TextBlock Text="Zoom" Style="{StaticResource PropLabelStyle}"/>
