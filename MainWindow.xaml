                Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                Padding="6,3">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Nuevo (Ctrl+N)" Click="NewFile_Click">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M4,2 H12 L16,6 V18 H4 Z M12,2 V6 H16"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Abrir (Ctrl+O)" Click="OpenFile_Click">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M2,5 H7 L9,7 H18 V16 H2 Z"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Guardar (Ctrl+S)" Click="SaveFile_Click">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M3,3 H14 L17,6 V17 H3 Z M6,3 H12 V8 H6 Z M6,17 V12 H14 V17"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Imprimir (Ctrl+P)">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M5,8 V3 H15 V8 M3,8 H17 V15 H13 V18 H7 V15 H3 Z M5,11 H11"/>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Cortar (Ctrl+X)">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M6,3 L16,17 M16,3 L6,17 M5,14 A2,2 0 1 0 5,18 A2,2 0 1 0 5,14 M19,14 A2,2 0 1 0 19,18 A2,2 0 1 0 19,14"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Copiar (Ctrl+C)">
